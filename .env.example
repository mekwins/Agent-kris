# --- Embeddings (any OpenAI-compatible endpoint) ---
EMBEDDING_ENDPOINT=https://<your-resource>.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2023-05-15
EMBEDDING_API_KEY=<your-azure-key>

# --- Compile agent (Claude via Azure AI Foundry) ---
ANTHROPIC_FOUNDRY_BASE_URL=https://<your-foundry-resource>.services.ai.azure.com/anthropic/v1
ANTHROPIC_FOUNDRY_API_KEY=<your-foundry-key>

# --- Multi-vault ---
# Root directory containing one folder per vault (vaults/<id>).
VAULTS_ROOT=./vaults
# Registry file listing the vaults.
WIKIS_CONFIG=./wikis.toml
# Vault used when a tool call omits `wiki`.
DEFAULT_WIKI=work

# --- MCP HTTP server ---
# Required for remote hosting: enforces x-api-key for non-localhost clients.
MCP_API_KEY=<generate-a-long-random-string>
# HOST/PORT are injected by the platform (fly sets PORT); default is 127.0.0.1:8765 locally.
