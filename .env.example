# --- Embeddings (any OpenAI-compatible endpoint) ---
EMBEDDING_ENDPOINT=https://ai-gateway.nexteer.app/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_API_KEY defaults to LLM_API_KEY (same gateway key)

# --- Compile agent (Claude via Nexteer AI Gateway) ---
LLM_BASE_URL=https://ai-gateway.nexteer.app
LLM_API_KEY=<gateway-service-key>
LLM_MODEL=deepseek-v4-flash
# LLM_PROFILE=<optional gateway AI Orchestration profile, sent as X-AI-Profile>
# Legacy fallback if LLM_* unset: ANTHROPIC_FOUNDRY_BASE_URL / ANTHROPIC_FOUNDRY_API_KEY

# --- Multi-vault ---
# Root directory containing one folder per vault (vaults/<id>).
VAULTS_ROOT=./vaults
# Registry file listing the vaults.
WIKIS_CONFIG=./wikis.toml
# Vault used when a tool call omits `wiki`.
DEFAULT_WIKI=work

# --- MCP HTTP server ---
# Required for remote hosting: enforces x-api-key for non-localhost clients.
MCP_API_KEY=<generate-a-long-random-string>
# HOST/PORT are injected by the platform (fly sets PORT); default is 127.0.0.1:8765 locally.
