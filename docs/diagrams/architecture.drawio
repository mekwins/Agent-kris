<mxfile host="app.diagrams.net" agent="brain-docs" version="24.0.0">
  <diagram name="Architecture" id="brain-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Brain — Multi-Vault Ingestion, Processing &amp; Retrieval" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Band labels -->
        <mxCell id="lbl_capture" value="1 · CAPTURE (append-only)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#6c8ebf;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl_proc" value="2 · MCP + COMPILE" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="440" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl_store" value="3 · PER-VAULT STORAGE" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="820" y="70" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl_sync" value="4 · SYNC" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="1120" y="70" width="240" height="20" as="geometry" />
        </mxCell>

        <!-- Capture -->
        <mxCell id="cap_claude" value="Claude Desktop / Web&#10;brain_write · brain_clip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cap_email" value="Email forward&#10;(IMAP connector — planned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cap_obs" value="Obsidian (local markdown edits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- MCP + compile -->
        <mxCell id="mcp" value="MCP Server (SSE)&#10;+ x-api-key auth&#10;8 brain_* tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="Registry: wikis.toml&#10;+ each vault's .brain/ profile&#10;→ resolves target Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inbox" value="&lt;vault&gt;/inbox/&#10;append-only captures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="compile" value="Compile Agent&#10;(Claude via Azure Foundry)&#10;reads .brain/ profile,&#10;resolves people, links tasks,&#10;inbox → wiki, then embeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Storage -->
        <mxCell id="wiki" value="&lt;vault&gt;/wiki/&#10;concepts · people · projects&#10;tasks · areas · brainstorm · learning&#10;index.md · log.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="processed" value="&lt;vault&gt;/processed/&#10;(compiled raw notes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="240" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vectors" value="&lt;vault&gt;/.vectors.json&#10;(per-vault embedding store, gitignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Retrieval -->
        <mxCell id="lbl_ret" value="5 · RETRIEVAL" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="Retrieval tools&#10;brain_search · brain_recall&#10;brain_context · brain_relate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="410" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="Embeddings API&#10;(Azure OpenAI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="425" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Sync -->
        <mxCell id="github" value="GitHub repo&#10;(one per vault — source of truth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="localclone" value="Local clone + Obsidian Git&#10;(pull / push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="220" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Edges: capture -> mcp/inbox -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cap_claude" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="cap_email" target="inbox"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- mcp writes inbox, triggers compile, registry resolves -->
        <mxCell id="e3" value="brain_write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mcp" target="inbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="brain_compile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="mcp" target="compile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="resolves vault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="registry" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- compile reads inbox, writes wiki/processed/vectors -->
        <mxCell id="e6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="inbox" target="compile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="writes pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="compile" target="wiki"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="mark_processed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="compile" target="processed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="embeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="compile" target="vectors"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- retrieval reads wiki + vectors, embeds query -->
        <mxCell id="e10" value="query embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ret" target="embed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="vector search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ret" target="vectors"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="keyword + wikilinks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ret" target="wiki"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="mcp" target="ret"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- sync -->
        <mxCell id="e14" value="pull / push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;endArrow=block;fontSize=10;" edge="1" parent="1" source="wiki" target="github"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="clone / sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;endArrow=block;fontSize=10;" edge="1" parent="1" source="github" target="localclone"><mxGeometry relative="1" as="geometry" /></mxCell>
